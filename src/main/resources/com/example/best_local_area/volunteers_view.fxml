<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" prefHeight="720.0" prefWidth="1280.0" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VolunteerController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="633.0" BorderPane.alignment="CENTER">
            <children>
            <Button fx:id="viewProfileButton" mnemonicParsing="false" onAction="#onViewProfileButtonClicked" prefWidth="150.0" styleClass="secondary-menu-button" stylesheets="@styling.css" text="View Profile">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin></Button>
                <Button fx:id="addVolunteerButton" alignment="BASELINE_LEFT" graphicTextGap="10.0" mnemonicParsing="false" onAction="#onAddVolunteerButtonClicked" prefHeight="25.0" prefWidth="150.0" styleClass="secondary-menu-button" stylesheets="@styling.css" text="Add Volunteer">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../icons/add-user-2-24.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <padding>
                        <Insets left="15.0" />
                    </padding>
                </Button>
                <Button fx:id="deleteVolunteerButton" alignment="BASELINE_LEFT" graphicTextGap="10.0" mnemonicParsing="false" onAction="#onDeleteVolunteerButtonClicked" prefWidth="150.0" styleClass="secondary-menu-button" stylesheets="@styling.css" text="Delete Volunteer">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../icons/remove-user-24.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <padding>
                        <Insets left="15.0" />
                    </padding>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
                </Button>
            </children>
            <padding>
                <Insets left="30.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <TableView fx:id="volunteerTableView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="id" />
                <TableColumn fx:id="firstnameColumn" prefWidth="120.0" text="First Name" />
                <TableColumn fx:id="lastnameColumn" prefWidth="120.0" text="Last Name" />
                <TableColumn fx:id="emailColumn" prefWidth="120.0" text="Email" />
                <TableColumn fx:id="phoneColumn" prefWidth="120.0" text="Phone Number" />
                <TableColumn fx:id="birthdayColumn" prefWidth="120.0" text="Birthday" />
                <TableColumn fx:id="isActiveColumn" prefWidth="75.0" text="isactive" />
            </columns>
        </TableView>
    </center>
</BorderPane>
