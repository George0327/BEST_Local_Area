<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" prefHeight="720.0" prefWidth="1280.0" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="633.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <TableView fx:id="userTableView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="id" />
                <TableColumn fx:id="usernameColumn" prefWidth="120.0" text="Username" />
                <TableColumn fx:id="passwordColumn" prefWidth="120.0" text="Password" />
                <TableColumn fx:id="volunteerColumn" prefWidth="120.0" text="Volunteer" />
                <TableColumn fx:id="roleColumn" prefWidth="75.0" text="Role" />
            </columns>
        </TableView>
    </center>
</BorderPane>
