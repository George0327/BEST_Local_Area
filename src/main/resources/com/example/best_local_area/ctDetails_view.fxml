<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="300.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CtDetailsController">
   <children>
      <BorderPane prefHeight="300.0" prefWidth="300.0">
         <left>
            <VBox prefHeight="400.0" prefWidth="150.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="Team Name:">
                     <VBox.margin>
                        <Insets bottom="30.0" left="20.0" />
                     </VBox.margin>
                  </Label>
                  <TableView fx:id="membersTableView" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="130.0">
                    <columns>
                      <TableColumn fx:id="membersColumn" prefWidth="130.0" text="Members" />
                    </columns>
                     <VBox.margin>
                        <Insets left="10.0" />
                     </VBox.margin>
                  </TableView>
               </children>
               <padding>
                  <Insets top="20.0" />
               </padding>
            </VBox>
         </left>
         <right>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="150.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="teamNameLabel" prefWidth="150.0" text="Label">
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" />
                     </VBox.margin></Label>
                  <Label text="Volunteer ID">
                     <VBox.margin>
                        <Insets top="30.0" />
                     </VBox.margin></Label>
                  <TextField fx:id="idTextField" maxWidth="-Infinity" prefWidth="120.0" />
                  <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAddButtonClick" prefWidth="120.0" text="Add Volunteer">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="removeButton" mnemonicParsing="false" onAction="#onRemoveButtonClick" prefWidth="120.0" text="Remove Volunteer">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
               <padding>
                  <Insets top="20.0" />
               </padding></VBox>
         </right></BorderPane>
   </children>
</AnchorPane>
